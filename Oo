-- 1. Spin Bot
local spinning = false
createPrankBtn("1. 🌀 หมุนตัวเป็นพายุ (Spin)", function()
    spinning = not spinning
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        if spinning then
            local spinner = Instance.new("BodyAngularVelocity")
            spinner.Name = "PrankSpinner"
            spinner.AngularVelocity = Vector3.new(0, 60, 0)
            spinner.MaxTorque = Vector3.new(0, math.huge, 0)
            spinner.Parent = char.HumanoidRootPart
        else
            if char.HumanoidRootPart:FindFirstChild("PrankSpinner") then
                char.HumanoidRootPart.PrankSpinner:Destroy()
            end
        end
    end
end)

